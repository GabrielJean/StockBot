# Create .env from this file and replace all development placeholders.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
WEBHOOK_ENCRYPTION_KEY=replace-with-a-fernet-key
DJANGO_DEBUG=true
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=
DATABASE_PATH=/data/db.sqlite3
COOKIE_SECURE=false
SCHEDULER_ENABLED=true
MONITOR_INTERVAL_SECONDS=60
NINTENDO_TIMEOUT_SECONDS=20
STOCKBOT_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36"
STOCKBOT_PORT=8000
